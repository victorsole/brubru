{
    "metadata": {
      "title": "EU Member States Permanent Representations to the European Union",
      "location": "Brussels, Belgium",
      "total_member_states": 27,
      "last_updated": "2025-11-06",
      "description": "All EU member states maintain permanent representations in Brussels serving as diplomatic missions to EU institutions. Permanent Representatives serve as ambassadors and participate in COREPER.",
      "sources": [
        "https://op.europa.eu/en/web/who-is-who/organization/-/organization/REPRES_PERM/REPRES_PERM",
        "https://www.consilium.europa.eu/"
      ]
    },
    "coreper_system": {
      "full_name": "Committee of Permanent Representatives",
      "acronym": "COREPER",
      "description": "The Council's main preparatory body composed of Permanent Representatives of member states",
      "structure": {
        "COREPER_II": {
          "composition": "Permanent Representatives (Ambassadors)",
          "role": "Prepares work for General Affairs Council, Foreign Affairs Council, Economic and Financial Affairs Council, and Justice and Home Affairs Council"
        },
        "COREPER_I": {
          "composition": "Deputy Permanent Representatives",
          "role": "Prepares work for sectoral Council configurations including Transport, Environment, Employment, Agriculture, Fisheries, Competitiveness, and Education"
        }
      },
      "meeting_frequency": "Weekly meetings to prepare Council sessions",
      "importance": "Key forum for negotiations and consensus-building at technical and political levels"
    },
