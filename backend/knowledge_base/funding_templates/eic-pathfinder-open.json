{
  "id": "eic-pathfinder-open",
  "name": "EIC Pathfinder Open  TRL 1-4 breakthrough deep-tech research",
  "programme": "EIC",
  "sub_instrument": "pathfinder-open",
  "stage": "single-stage",
  "scaffold_version": "2026-WP",
  "official_template_url": "https://eic.ec.europa.eu/eic-funding-opportunities/eic-pathfinder_en",
  "kb_guide": "eic_pathfinder_process",
  "topic_id_default": "HORIZON-EIC-2026-PATHFINDEROPEN-01",
  "deadline_2026_cet": "2026-05-12T17:00:00+02:00",
  "documents": [
    {
      "kind": "tender_application_full",
      "title": "Part B  Pathfinder Open Technical Proposal (RIA template)",
      "page_limit": 45,
      "formatting": {
        "font": "Times New Roman 11pt min",
        "page_size": "A4",
        "margins_mm": 15
      },
      "render": "ai-narrative",
      "ai_disclosure_required": true,
      "sections": [
        {
          "id": "1-excellence",
          "label": "1. Excellence",
          "page_budget": 15,
          "criterion": "Excellence",
          "sub": [
            {
              "id": "1.1",
              "label": "1.1 Long-term vision + radically new technology",
              "prompts": [
                "Describe the radically new technology vision and the science-towards-technology breakthrough."
              ]
            },
            {
              "id": "1.2",
              "label": "1.2 Concrete + novel science-towards-technology breakthrough",
              "prompts": [
                "What is the concrete novel and ambitious science-towards-technology breakthrough you propose?"
              ]
            },
            {
              "id": "1.3",
              "label": "1.3 High-risk / high-gain research approach + methodology",
              "prompts": [
                "Describe the high-risk/high-gain approach + methodology + concrete and plausible objectives."
              ]
            },
            {
              "id": "1.4",
              "label": "1.4 Interdisciplinarity",
              "prompts": [
                "How does the proposal combine different disciplines? Why is this necessary for the breakthrough?"
              ]
            }
          ]
        },
        {
          "id": "2-impact",
          "label": "2. Impact",
          "page_budget": 12,
          "criterion": "Impact",
          "sub": [
            {
              "id": "2.1",
              "label": "2.1 Potential for new markets + transformation",
              "prompts": [
                "Future application areas + potential to create new markets and transform existing ones."
              ]
            },
            {
              "id": "2.2",
              "label": "2.2 Communication + dissemination + IPR strategy",
              "prompts": [
                "Open-science obligations; dissemination plan; IPR exploitation strategy."
              ]
            }
          ]
        },
        {
          "id": "3-implementation",
          "label": "3. Quality + efficiency of implementation",
          "page_budget": 15,
          "criterion": "Implementation",
          "sub": [
            {
              "id": "3.1",
              "label": "3.1 Work plan + work packages + deliverables + milestones",
              "prompts": [
                "Define WPs, deliverables, milestones, critical risks, contingency."
              ]
            },
            {
              "id": "3.2",
              "label": "3.2 Capacity of consortium",
              "prompts": [
                "Roles, complementarities, distribution of tasks, gender balance in consortium."
              ]
            },
            {
              "id": "3.3",
              "label": "3.3 Resources",
              "prompts": [
                "Personnel, subcontracting, equipment depreciation, indirect costs (25% flat rate)."
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "tender_consortium_agreement",
      "title": "Consortium description (3+ entities from 3+ MS/AC)",
      "render": "table-driven",
      "constraints": {
        "min_partners": 3,
        "min_member_states": 3
      }
    },
    {
      "kind": "tender_ethics_self_assessment",
      "title": "Ethics Self-Assessment annex",
      "render": "ai-narrative",
      "conditional": {
        "ethics_any_yes": true
      }
    }
  ],
  "comply_targets": [
    "AI",
    "GDPR",
    "Research Integrity",
    "Dual-Use",
    "Data Act"
  ],
  "hand_offs": {
    "next_stage": "eic-transition",
    "chat_cta": "Ask Brubru if my consortium configuration meets the 3-from-3 rule",
    "comply_cta": "Run dual-use + research-integrity check"
  },
